# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored. Never commit a real key.

# Gemini API key (from https://aistudio.google.com/apikey). Used ONLY by the backend.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional
# DATABASE_URL=sqlite:///./data/tester.db
# CORS_ORIGINS=http://localhost:5190
